# Lo llena `tutomatic setup`. Si prefieres a mano: cópialo a .env y completa tus claves. Nunca lo subas a git.

# Google (voz Gemini TTS, música Lyria, imagen): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionales
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# VoiceStudio local (opcional; por defecto http://localhost:3900/v1)
# VOICESTUDIO_URL=http://localhost:3900/v1

# Credenciales del usuario de la app (se usan como ${TUTO_USER} / ${TUTO_PASSWORD} en el storyboard)
TUTO_USER=
TUTO_PASSWORD=

# Fuerza un proveedor en todo (p. ej. mock para ensayar gratis)
# TUTO_PROVIDER=mock

# Opcional: navegador para Remotion / grabación
# REMOTION_BROWSER=
# TUTO_CHROME=
